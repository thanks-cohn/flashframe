{
  "manifest_version": 3,
  "name": "Flashframe",
  "version": "1.0.3",
  "description": "A spatial workspace for Chrome and Chromium.",
  "action": {
    "default_title": "Open Flashframe"
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_embed_identity",
        "enabled": true,
        "path": "rules/youtube-embed-identity.json"
      }
    ]
  }
}
