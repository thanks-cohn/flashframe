{
  "manifest_version": 3,
  "name": "FrameChute",
  "version": "1.0.8",
  "description": "Arrange notes, PDFs, images, audio, video, and links in a persistent spatial workspace.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open FrameChute",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  }
}
